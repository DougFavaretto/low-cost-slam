<launch>

  <!-- Conexão TCP com ESP8266 -->
  <node pkg="rosserial_python" type="serial_node.py" name="serial" output="screen">
    <param name="port" value="tcp" />
  </node>
  
  <!-- Nó de odometria baseado em IMU -->
  <node pkg="low-cost-slam" type="imu_odom.py" name="imu_odom" output="screen" />

  <!-- Nó de mapeamento simples -->
  <node pkg="low-cost-slam" type="simple_mapper.py" name="simple_mapper" output="screen" />

  <!-- Nó de escaneamento a laser -->
  <node pkg="low-cost-slam" type="laser_scan.py" name="laser_scan" output="screen" />
</launch>
